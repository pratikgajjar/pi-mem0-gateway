{
  "name": "pi-mem0-gateway",
  "version": "0.5.0",
  "description": "pi extension: reach every connector behind the mem0 gateway from one tool. Five operations, credentials stay server-side",
  "type": "module",
  "license": "MIT",
  "author": "pratikgajjar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratikgajjar/pi-mem0-gateway.git"
  },
  "homepage": "https://github.com/pratikgajjar/pi-mem0-gateway#readme",
  "bugs": {
    "url": "https://github.com/pratikgajjar/pi-mem0-gateway/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-skill",
    "coding-agent",
    "mem0",
    "mcp",
    "gateway",
    "connectors",
    "tool-access"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "release": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
